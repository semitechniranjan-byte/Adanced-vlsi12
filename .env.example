# Copy this file to .env and fill in real values.
# NEVER commit .env — it is already in .gitignore.

# ---- Database (Neon Postgres) ----
# Use the POOLED connection string (host ends in -pooler) for the app
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/advancedvlsi?sslmode=require&pgbouncer=true"
# Direct connection, used only for migrations
DIRECT_URL="postgresql://user:pass@ep-xxxx.region.aws.neon.tech/advancedvlsi?sslmode=require"

# ---- Auth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google Sign-In — console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- File storage (Cloudflare R2) ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_PUBLIC="avlsi-public"
R2_BUCKET_PRIVATE="avlsi-private"
R2_PUBLIC_URL="https://cdn.advancedvlsi.com"

# ---- Email (Resend) ----
RESEND_API_KEY=""
EMAIL_FROM="Advanced VLSI <noreply@advancedvlsi.com>"

# ---- Cron ----
# Any long random string; check this header inside /api/cron/*
CRON_SECRET=""
